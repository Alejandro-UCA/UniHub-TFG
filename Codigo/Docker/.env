# ==============================================================================
# Variables de Entorno del Sistema Docker RUCT (Fase 4)
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=ruct_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin

# Read-only API Service User
POSTGRES_API_USER=ruct_api_user
POSTGRES_API_PASSWORD=ruct_api_pass_2026

# Exposed Ports on Host
API_PORT=8000
WEB_PORT=80
WEB_ALT_PORT=5173

# Application Admin Credentials
WEB_ADMIN_USER=admin
WEB_ADMIN_PASSWORD=admin_pass_2026
