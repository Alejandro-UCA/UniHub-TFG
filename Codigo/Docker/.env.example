# Copiar como Codigo/Docker/.env y completar localmente.
# Nunca incluir secretos reales en el repositorio.

ENVIRONMENT=production

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=unihub_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_POR_UN_SECRETO_LARGO

POSTGRES_API_USER=unihub_api_user
POSTGRES_API_PASSWORD=CAMBIAR_POR_OTRO_SECRETO_LARGO

API_PORT=8000
WEB_PORT=80
WEB_ALT_PORT=5173

ADMIN_API_KEY=CAMBIAR_POR_UNA_CLAVE_ALEATORIA_LARGA
# Durante una rotación se pueden aceptar varias claves separadas por comas.
# ADMIN_API_KEYS=CLAVE_NUEVA,CLAVE_ANTIGUA
CORS_ORIGINS=http://localhost

CRAWLER_CRON_SCHEDULE=0 2 1 * *
CRAWLER_REQUEST_DELAY=1.0
CRAWLER_RUN_ON_STARTUP=true
API_SYNC_URL=http://api:8000/api/v1/admin/sync-etl
CRAWLER_API_SYNC_TIMEOUT=600

VITE_API_URL=/api/v1
VITE_ADMIN_USER=admin
VITE_ADMIN_FEES=45.00
VITE_BECA_MEC_REFERENCE_PRICE=1008
