# PostgreSQL Database Configuration
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=unihub_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin

# Read-only API Service User
POSTGRES_API_USER=unihub_api_user
POSTGRES_API_PASSWORD=unihub_api_password_sec2026

# Exposed Ports on Host
API_PORT=8000
WEB_PORT=80
WEB_ALT_PORT=5173

# Application Admin Credentials
WEB_ADMIN_USER=admin
ADMIN_API_KEY=unihub_super_secret_admin_key_2026

# Public API URL for Frontend
VITE_API_URL=http://localhost:8000/api/v1
