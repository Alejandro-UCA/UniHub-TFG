# ==============================================================================
# Variables de Entorno del Sistema Docker RUCT (Fase 4)
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=unihub_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin

# Read-only API Service User
POSTGRES_API_USER=unihub_api_user
POSTGRES_API_PASSWORD=unihub_api_password_sec2026

# Exposed Ports on Host
API_PORT=8000
WEB_PORT=80
WEB_ALT_PORT=5173

# Application Admin Credentials
ADMIN_API_KEY=unihub_super_secret_admin_key_2026

# Crawler Frecuencia (Cron) y Retraso
CRAWLER_CRON_SCHEDULE=0 2 1 * *
CRAWLER_REQUEST_DELAY=1.0

# Frontend Web Configuración Dinámica
VITE_API_URL=/api/v1
VITE_ADMIN_USER=admin
VITE_ADMIN_FEES=45.00
VITE_BECA_MEC_REFERENCE_PRICE=1008
